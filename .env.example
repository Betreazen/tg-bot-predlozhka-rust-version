# Copy to .env (or /etc/tg-bot-predlozhka/bot.env) and restrict it: chmod 600.
# Never run two bots with the same token: Telegram answers the second poller with 409.
BOT_TOKEN=
# The bot must be an admin of the channel and a member of both chats.
CHANNEL_ID=
ADMIN_CHAT_ID=
# Publication failures go here; defaults to ADMIN_CHAT_ID.
ERROR_CHAT_ID=
# Telegram user IDs allowed to moderate, separated by commas.
ADMIN_IDS=

# Optional, defaults shown.
# SUBMISSIONS_PER_DAY=2
# TIMEZONE=Europe/Moscow
# PUBLICATION_DELAY_MINUTES=2
# MAX_FILE_SIZE_MB=200
# FOOTER_TEXT=
# HASHTAGS=
# REQUIRE_CONFIRMATION=true
# ENABLE_BLOCKING=true
# MAX_RETRY_ATTEMPTS=2
# RETRY_DELAY_SECONDS=30
# RUST_LOG=info
